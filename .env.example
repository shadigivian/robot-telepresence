# Set these in your shell or hosting dashboard. server.js does not load .env files.
PORT=3000
HOST=127.0.0.1
DATA_FILE=./data/site.json
# Comma-separated exact HTTPS frontend origins, without trailing slash.
ALLOWED_ORIGINS=https://shadigivian.github.io
# Only needed during `npm run setup`; remove afterward.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Keep provider keys on the server, never in public/config.js.
TURN_CREDENTIALS_URL=
# Alternative: JSON array of TURN servers, ideally with expiring credentials.
TURN_SERVERS=[]
