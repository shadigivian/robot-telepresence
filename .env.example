# Copy to .env in the repository root for private local settings.
# Server and setup load .env automatically; shell/hosting variables take priority.
# Never commit .env or put these provider settings in public/config.js.
PORT=3000
HOST=127.0.0.1
DATA_FILE=./data/site.json
# Comma-separated exact HTTPS frontend origins, without trailing slash.
ALLOWED_ORIGINS=https://shadigivian.github.io
# Only needed during `npm run setup`; remove afterward.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Keep provider keys on the server, never in public/config.js.
TURN_CREDENTIALS_URL=
# Metered example (replace placeholders in private .env only):
# TURN_CREDENTIALS_URL=https://YOUR_APP.metered.live/api/v1/turn/credentials?apiKey=YOUR_CREDENTIAL_API_KEY
# Alternative: JSON array of TURN servers, ideally with expiring credentials.
TURN_SERVERS=[]
