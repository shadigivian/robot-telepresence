# Set these to the HTTPS origins used by the shared deployment build.
VITE_BOSS_ORIGIN=https://boss.example.com
VITE_APP_ORIGIN=https://app.example.com
VITE_API_ORIGIN=https://api.example.com
# Only for a separate test build served behind VPN, IP allowlist, or server authentication.
# Never enable in a public production bundle.
VITE_STAGING_DEMO=false
